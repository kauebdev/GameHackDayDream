// Configurações de spawn
spawn_timer = 0;          // Contador inicial
spawn_interval = 0;     // Intervalo entre gerações (em frames)
max_inimigos = 2;        // Número máximo de inimigos permitidos

// Limites do mapa (ajuste para a sua sala)
spawn_min_x = 100;
spawn_max_x = room_width - 100;
spawn_min_y = 100;
spawn_max_y = room_height - 100;
